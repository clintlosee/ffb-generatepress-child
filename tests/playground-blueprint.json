{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/gear/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "generatepress"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; switch_theme( 'flybasics-generatepress-child' );"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-content/themes/flybasics-generatepress-child/tests/playground-seed.php';"
		}
	]
}
